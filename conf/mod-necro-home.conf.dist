[worldserver]

###################################################################################################
# MOD TRAVELER'S RECALL
#

#
#   Show Welcome Message
#       Description: Enable or disable if the message "This server uses NecroHome module" on player login
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.ShowWelcomeMessage = 1

#
#   Start With Professions
#       Description: Enable or disable if the player will start with professions
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithAlchemy = 1
NecroHome.StartWithBlacksmithing = 1
NecroHome.StartWithEnchanting = 1
NecroHome.StartWithEngineering = 1
NecroHome.StartWithHerbalism = 1
NecroHome.StartWithInscription = 1
NecroHome.StartWithJewelcrafting = 1
NecroHome.StartWithLeatherworking = 1
NecroHome.StartWithMining = 1
NecroHome.StartWithSkinning = 1
NecroHome.StartWithTailoring = 1
NecroHome.StartWithCooking = 1
NecroHome.StartWithFirstAid = 1
NecroHome.StartWithFishing = 1

#
#   Start With All Bags
#       Description: Enable or disable if the player will start with all 4 Bags
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithAllBags = 1

#
#   Bag Item Id
#       Description: The bag item id that will be equiped in the slots
#       Default:        23162 (Foror's Crate of Endless Resist Gear Storage)
#

NecroHome.BagItemId = 23162

#
#   Start with Mining Pick
#       Description: Enable or disable if the player will start with a Mining Pick
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithMiningPink = 1

#
#   Start with Skinning Knife
#       Description: Enable or disable if the player will start a Skinning Knife
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithSkinningKnife = 1

#
#   Start with Fishing Pole
#       Description: Enable or disable if the player will start a Fishing Pole
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithFishingPole = 1

#
#   Start with Blacksmith Hammer
#       Description: Enable or disable if the player will start a Blacksmith Hammer
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithBlacksmithHammer = 1

#
#   Start with Flint and Tinder
#       Description: Enable or disable if the player will start a Flint and Tinder
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithFlintAndTinder = 1

#
#   Start with Simple Wood
#       Description: Enable or disable if the player will start Simple Wood
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithSimpleWood = 1

#
#   Simple Wood Start ammount
#       Description: Define how many Simple Wood the player will start with
#       Default:        5000
#

NecroHome.SimpleWoodStartAmmount = 5000

#
#   Start With All Bank
#       Description: Enable or disable if the player will start with all bank slots unlocked
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithAllBankBags = 1

#
#   Bank Bag Item Id
#       Description: The bag item id that will be equiped in the bank slots
#       Default:        23162 (Foror's Crate of Endless Resist Gear Storage)
#

NecroHome.BankBagItemId = 23162

#
#   Start With Mount
#       Description: Enable or disable if the player will start with basic mount skill and a 60% mount
#       Default:        1 (enabled)
#                       0 (disabled)
#

NecroHome.StartWithMount = 1

#
#   Race Mount ID
#       Description: The mount id to wich each race will start the game
#       Default:        Human = 458 (Brown Horse)
#                       Orc = 459 (Brown Wolf)
#                       Dwarf = 6899 (Drown Ram)
#                       Nightelf = 10789 (Spotted Frostsaber)
#                       Undead = 17462 (Red Skeletal Horse)
#                       Tauren = 18990 (Brown Kodo)
#                       Gnome = 17453 (Green Mechanostrider)
#                       Troll = 17464 (Brown Raptor)
#                       Bloodelf = 34795 (Red Hawkstrider)
#                       Draenei = 34406 (Brown Elekk)
#

NecroHome.StartMountIdHuman = 458
NecroHome.StartMountIdOrc = 459
NecroHome.StartMountIdDwarf = 6899
NecroHome.StartMountIdNightelf = 10789
NecroHome.StartMountIdUndead = 17462
NecroHome.StartMountIdTauren = 18990
NecroHome.StartMountIdGnome = 17453
NecroHome.StartMountIdTroll = 17464
NecroHome.StartMountIdBloodelf = 34795
NecroHome.StartMountIdDraenei = 34406

#
#   Start Gold
#       Description: Set the ammount of gold the player will start the game with
#       Default:        5000
#

NecroHome.StartGoldAmmount = 5000